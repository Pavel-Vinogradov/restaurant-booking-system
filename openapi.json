                    },
                    "data": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationException"
          },
          "422": {
            "$ref": "#/components/responses/ValidationException"
          }
        }
      }
    },
    "/auth/phone/send-code": {
      "post": {
        "operationId": "auth.sendPhoneCode",
        "summary": "Отправить SMS-код для верификации телефона",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
